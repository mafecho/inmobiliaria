<%
  // Fase 2: estas tarjetas salen de la base de datos. Hasta el 2026-11-26
  // acá había un arreglo de propiedades de ejemplo escrito a mano dentro de
  // este mismo template.
  //
  // `destacadas` lo arma routes/public.js y llega vacío si la consulta falla,
  // a propósito: el resto de la landing —servicios, formulario, FAQ— no
  // depende de la base, y no tiene por qué caerse con ella.
%>
<section class="section" id="destacados">
  <div class="section-head">
    <span class="eyebrow">Portafolio</span>
    <h2>Una muestra de nuestras propiedades</h2>
    <% if (destacadas.length > 0) { %>
      <p>Propiedades disponibles ahora mismo. Escríbanos para recibir opciones a su medida.</p>
    <% } else { %>
      <p>Estamos cargando el inventario. Escríbanos y le enviamos opciones a su medida.</p>
    <% } %>
  </div>

  <% if (destacadas.length > 0) { %>
    <div class="properties-scroller">
      <% destacadas.forEach(function (p) { %>
        <%- include('propiedad-card', { p: p }) %>
      <% }); %>
    </div>

    <p class="properties-note">
      <a href="/propiedades" class="btn btn--primary">Ver todas las propiedades</a>
    </p>
  <% } else { %>
    <div class="vacio vacio--publico">
      <p>
        Todavía no hay propiedades publicadas en el sitio.
        Cuéntenos qué está buscando y un asesor le responde con opciones concretas.
      </p>
      <div class="vacio__acciones">
        <a href="#consigna" class="btn btn--primary"
           data-lead-tipo="comprar" data-lead-etiqueta="Buscar una propiedad a la medida">
          Cuéntenos qué necesita
        </a>
      </div>
    </div>
  <% } %>
</section>
