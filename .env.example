DB_HOST=localhost
DB_USER=echavarria_dev
DB_PASS=echavarria_dev_local
DB_NAME=echavarria_dev

# Panel de administración (Fase 2).
# SESSION_SECRET es OBLIGATORIO en producción: sin él el panel responde 503 en
# todas sus rutas y sólo funciona el sitio público. En desarrollo hay un valor
# por defecto. Genere uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
# SESSION_HORAS=12

# Fotos de las propiedades. En producción DEBE apuntar fuera del docroot:
# deploy.sh corre `git reset --hard` en cada despliegue, y el inventario
# fotográfico no tiene por qué vivir dentro del árbol del repo.
# En desarrollo, si se omite, se usa public/uploads.
# UPLOAD_DIR=/home/moralesbilma/fotos-echavarria
# UPLOAD_MAX_MB=6
# UPLOAD_MAX_FOTOS=20

# Opcionales — si faltan, el sitio levanta igual (ver config/index.js).
# PORT=3000
# DOMAIN=echavarria-gi.com
# CONTACTO_WHATSAPP=57...
# CONTACTO_EMAIL=contacto@echavarria-gi.com
# LOG_LEVEL=debug
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_CONTACT_MAX=10
# RATE_LIMIT_LOGIN_MAX=8
